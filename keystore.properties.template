# Copy this file to `keystore.properties` (which is gitignored) and fill in your release key.
# Generate a key with:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias ai-notebook
#
# NEVER commit keystore.properties or the .jks file.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=ai-notebook
keyPassword=CHANGE_ME
